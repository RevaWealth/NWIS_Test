# NWIS Token Deployment Configuration
# Copy this file to .env and fill in your values

# NWIS Token Multi-Chain Deployment Configuration
# Copy this file to .env and fill in your values

# API Configuration for Total Supply Endpoint
# Replace with your actual deployed contract address
NWIS_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Ethereum Network Configuration
PRIVATE_KEY=your_private_key_here_without_0x_prefix
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
MAINNET_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Base Network Configuration
BASE_URL=https://mainnet.base.org
BASE_SEPOLIA_URL=https://sepolia.base.org

# Block Explorer API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# Optional: Alternative RPC Providers
# ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Cookie Tracking Configuration
# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Facebook Pixel ID (optional)
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXX

# Other tracking services can be added here
# NEXT_PUBLIC_HOTJAR_ID=XXXXXXXXXX
