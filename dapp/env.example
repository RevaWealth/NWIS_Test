# NexusWealth DApp Configuration - SEPOLIA TESTNET
# Copy this file to .env.local for local development

# ========================================
# NETWORK CONFIGURATION
# ========================================

# Chain ID (Sepolia = 11155111)
NEXT_PUBLIC_CHAIN_ID=11155111

# Network Name
NEXT_PUBLIC_NETWORK_NAME=sepolia

# ========================================
# CONTRACT ADDRESSES (SEPOLIA TESTNET)
# ========================================

# Presale Contract Address on Sepolia
NEXT_PUBLIC_PRESALE_CONTRACT_ADDRESS=0xfA9394b5624B7a608079Db4B04D5d55715b8ad7E

# NWIS Token Contract Address on Sepolia (if deployed)
# NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=0xYourTokenAddress

# ========================================
# WALLET CONNECT
# ========================================

# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=5564c86f2bd7f6fbadb17a8af2161f9f

# ========================================
# RPC CONFIGURATION (SEPOLIA)
# ========================================

# Infura Sepolia URL (optional - wagmi uses public RPCs by default)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Alchemy Sepolia URL (optional)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ========================================
# TESTNET TOKEN ADDRESSES (SEPOLIA)
# ========================================

# USDT on Sepolia
NEXT_PUBLIC_USDT_ADDRESS=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# USDC on Sepolia
NEXT_PUBLIC_USDC_ADDRESS=0x94a9D9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8

# ========================================
# FEATURE FLAGS
# ========================================

# Enable testnet mode
NEXT_PUBLIC_IS_TESTNET=true

# Enable debug mode
NEXT_PUBLIC_DEBUG_MODE=true

# ========================================
# ANALYTICS (Optional)
# ========================================

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# NOTES FOR TESTING
# ========================================
